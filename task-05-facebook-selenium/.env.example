# Facebook Selenium Automation Configuration
# Copy this file to .env and adjust as needed.
# Note: Zero passwords, credentials, or session cookies should EVER be stored here.

# Staged post message
FB_POST_TEXT="Hello from Python & Selenium automated post workflow!"

# Local persistent Chrome user profile directory (relative to task folder or absolute)
# This allows manual interactive login once in the visible browser without storing passwords in code.
CHROME_USER_DATA_DIR="chrome_profile"

# Execution mode: true = dry-run (stages post without publishing), false = normal execution
DRY_RUN="true"

# Target mode: "facebook" for real Facebook UI, "local" for local offline test fixture
TARGET_MODE="local"
